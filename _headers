# HTML — always revalidate so users pick up new asset version strings
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/html/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Versioned assets (?v=...) — cache aggressively; busted by query string on deploy
/js/*.js
  Cache-Control: public, max-age=31536000, immutable

/css/*.css
  Cache-Control: public, max-age=31536000, immutable

# Static media
/*.svg
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800
